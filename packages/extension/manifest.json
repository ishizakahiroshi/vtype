{
  "manifest_version": 3,
  "name": "vtype",
  "version": "0.0.1",
  "description": "Voice input for any text field on the web. Uses the browser's built-in speech recognition.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "storage"],
  "action": {
    "default_title": "vtype: switch this site on or off"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
